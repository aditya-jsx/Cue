# Copy to .env (gitignored) and fill in. Restart Metro after changing these.

# Where the Cue parser server is deployed (see server/). No trailing slash.
EXPO_PUBLIC_CUE_API_URL=https://your-cue-parser.vercel.app

# Must match CUE_CLIENT_TOKEN on the server. It ships inside the app, so it is only a weak
# deterrent against casual abuse, not a secret.
EXPO_PUBLIC_CUE_CLIENT_TOKEN=change-me
